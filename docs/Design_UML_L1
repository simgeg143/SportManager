@startuml
skinparam classAttributeIconSize 0
left to right direction
skinparam packageStyle rectangle

package "UI Layer" {
class UIControllers
}

package "Core Layer" {

class SportManager {
+ startNewGame()
+ selectSport()
+ selectManagedTeam()
+ advanceWeek()
+ startMatch()
}

class GameSession {
- currentWeek : int
- selectedSport : Sport
- managedTeam : Team
- league : League
}

abstract class League {
- teams : List<Team>
- fixtures : List<Match>
- standings : List<StandingEntry>
+ generateFixtures()
+ updateStandings()
+ getTable()
}

abstract class Team {
- players : List<Player>
- coaches : List<Coach>
- currentLineup : Lineup
- currentTactic : Tactic
+ getAvailablePlayers()
+ setLineup()
+ setTactic()
}

abstract class Player {
- position : String
- fitness : int
- injuredMatches : int
+ isAvailable()
+ recover()
}

class Match {
- homeScore : int
- awayScore : int
+ start()
+ play()
+ finish()
}

class StandingEntry
class Lineup
class Tactic
class Coach
}

package "Sport Abstraction" {
interface Sport {
+ createLeague()
+ createTeam()
+ createPlayer()
+ createMatch()
+ calculatePoints()
+ applyInjuries()
}

class SportFactory {
+ createSport()
}
}

package "Football Module" {
class FootballSport
}

UIControllers --> SportManager
SportManager --> GameSession
SportManager --> SportFactory

GameSession --> Sport
GameSession --> League
GameSession --> Team

League --> Match
League --> StandingEntry
League --> Team

Team --> Player
Team --> Coach
Team --> Lineup
Team --> Tactic

SportFactory ..> Sport
FootballSport ..|> Sport

@enduml