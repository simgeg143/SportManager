<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportmanager.ui.controller.MatchScreenController"
            styleClass="root-pane">

    <!-- ── SCOREBOARD ───────────────────────────────────────────────────── -->
    <top>
        <VBox styleClass="scoreboard-panel">
            <HBox alignment="CENTER" spacing="0" styleClass="scoreboard-row">
                <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" styleClass="team-side">
                    <Label fx:id="homeTeamLabel" text="Home Team" styleClass="match-team-name"/>
                    <Label text="HOME" styleClass="venue-badge"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="score-block">
                    <Label fx:id="scoreLabel" text="0  –  0" styleClass="score-display"/>
                    <Label fx:id="matchInfoLabel" text=""   styleClass="match-info-label"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="team-side">
                    <Label fx:id="awayTeamLabel" text="Away Team" styleClass="match-team-name"/>
                    <Label text="AWAY" styleClass="venue-badge"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ── CENTRE: events + break panel ────────────────────────────────── -->
    <center>
        <HBox spacing="16" styleClass="match-center">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Event log -->
            <VBox HBox.hgrow="ALWAYS" spacing="8" styleClass="card">
                <Label text="MATCH EVENTS" styleClass="section-label"/>
                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="events-scroll">
                    <VBox fx:id="eventsBox" spacing="4" styleClass="events-inner">
                        <padding><Insets top="4" right="8" bottom="4" left="8"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Right panel: substitution + tactic -->
            <VBox fx:id="subPanel" spacing="12" prefWidth="280" styleClass="card"
                  visible="false" managed="true">
                <Label text="HALF TIME" styleClass="section-label"/>

                <Label text="Substitution (max 3)" styleClass="label-small"/>
                <Label text="Remove from XI:" styleClass="label-small"/>
                <ComboBox fx:id="removePlayerCombo" maxWidth="Infinity"
                          styleClass="tactic-combo"/>
                <Label text="Add from bench:" styleClass="label-small"/>
                <ComboBox fx:id="addPlayerCombo" maxWidth="Infinity"
                          styleClass="tactic-combo"/>
                <Label fx:id="subCountLabel" text="Subs: 0 / 3" styleClass="label-small"/>
                <Button text="Make Substitution" onAction="#onMakeSubstitution"
                        maxWidth="Infinity" styleClass="btn-secondary"/>

                <Separator/>

                <Label text="Change Tactic:" styleClass="label-small"/>
                <ComboBox fx:id="tacticCombo" maxWidth="Infinity" styleClass="tactic-combo"/>
                <Button text="Apply Tactic" onAction="#onApplyTactic"
                        maxWidth="Infinity" styleClass="btn-secondary"/>
            </VBox>
        </HBox>
    </center>

    <!-- ── BOTTOM CONTROLS ──────────────────────────────────────────────── -->
    <bottom>
        <HBox styleClass="bottom-bar" alignment="CENTER" spacing="20">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button fx:id="simulateButton" text="▶  Play First Half"
                    onAction="#onSimulateNext" styleClass="btn-primary" prefWidth="200"/>
            <Button fx:id="continueButton" text="Continue →"
                    onAction="#onContinue"    styleClass="btn-success" prefWidth="160"
                    visible="false"/>
        </HBox>
    </bottom>

</BorderPane>
