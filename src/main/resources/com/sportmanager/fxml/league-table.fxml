<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportmanager.ui.controller.LeagueTableController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button text="← Back" onAction="#onBack" styleClass="nav-btn"/>
            <Label text="📊" styleClass="nav-icon"/>
            <Label fx:id="leagueNameLabel" text="League Table" styleClass="nav-team-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="weekLabel" text="" styleClass="nav-subtitle"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="page-body">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <TableView fx:id="standingsTable" VBox.vgrow="ALWAYS" styleClass="standings-table">
                <columns>
                    <TableColumn fx:id="posCol"   text="#"   prefWidth="40"  minWidth="35"/>
                    <TableColumn fx:id="teamCol"  text="Club" prefWidth="200" minWidth="130"/>
                    <TableColumn fx:id="pldCol"   text="P"   prefWidth="45"  minWidth="35"/>
                    <TableColumn fx:id="wonCol"   text="W"   prefWidth="45"  minWidth="35"/>
                    <TableColumn fx:id="drawnCol" text="D"   prefWidth="45"  minWidth="35"/>
                    <TableColumn fx:id="lostCol"  text="L"   prefWidth="45"  minWidth="35"/>
                    <TableColumn fx:id="gfCol"    text="GF"  prefWidth="50"  minWidth="40"/>
                    <TableColumn fx:id="gaCol"    text="GA"  prefWidth="50"  minWidth="40"/>
                    <TableColumn fx:id="gdCol"    text="GD"  prefWidth="55"  minWidth="40"/>
                    <TableColumn fx:id="ptsCol"   text="Pts" prefWidth="55"  minWidth="45"/>
                </columns>
                <placeholder><Label text="No standings data."/></placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>
