<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportmanager.ui.controller.FixtureController"
            styleClass="root-pane">

    <!-- ── TOP BAR ──────────────────────────────────────────────────────── -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button text="← Back" onAction="#onBack" styleClass="nav-btn"/>
            <Label text="📋" styleClass="nav-icon"/>
            <Label fx:id="leagueNameLabel" text="League" styleClass="nav-team-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="seasonLabel" text="Season Schedule" styleClass="nav-subtitle"/>
        </HBox>
    </top>

    <!-- ── FIXTURES TABLE ───────────────────────────────────────────────── -->
    <center>
        <VBox spacing="12" styleClass="page-body" minWidth="0" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <TableView fx:id="fixtureTable" VBox.vgrow="ALWAYS" styleClass="fixture-table">
                <columns>
                    <TableColumn fx:id="weekCol"   text="Wk"    prefWidth="45"  minWidth="40"/>
                    <TableColumn fx:id="homeCol"   text="Home"  prefWidth="220" minWidth="140"/>
                    <TableColumn fx:id="scoreCol"  text="Score" prefWidth="80"  minWidth="60"/>
                    <TableColumn fx:id="awayCol"   text="Away"  prefWidth="220" minWidth="140"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="90" minWidth="70"/>
                </columns>
                <placeholder><Label text="No fixtures generated yet."/></placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>
