<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sportmanager.ui.controller.MainMenuController"
           styleClass="root-pane">

    <!-- Full-screen gradient backdrop -->
    <VBox alignment="CENTER" spacing="0" styleClass="main-menu-bg">

        <!-- Hero block -->
        <VBox alignment="CENTER" spacing="12" styleClass="hero-block">
            <Label text="🏅" styleClass="hero-icon"/>
            <Label text="SPORT MANAGER" styleClass="title-label"/>
            <Label text="Build your dynasty across football and basketball." styleClass="subtitle-label"/>
        </VBox>

        <!-- Spacer -->
        <Region prefHeight="50"/>

        <!-- Navigation buttons -->
        <VBox alignment="CENTER" spacing="14" styleClass="menu-buttons-box">
            <Button text="NEW GAME"   onAction="#onNewGame"   styleClass="menu-btn,menu-btn-primary" maxWidth="300" prefWidth="300"/>
            <Button text="LOAD GAME"  onAction="#onLoadGame"  styleClass="menu-btn"                  maxWidth="300" prefWidth="300"/>
            <Button text="EXIT"       onAction="#onExit"      styleClass="menu-btn,menu-btn-danger"   maxWidth="300" prefWidth="300"/>
        </VBox>

        <!-- Version stamp -->
        <Region prefHeight="60"/>
        <Label text="v2.0 · Multi-Sport Career Mode" styleClass="version-label"/>

    </VBox>

    <StackPane fx:id="loadOverlay" visible="false" managed="false" styleClass="sub-overlay">
        <VBox spacing="10" maxWidth="760" styleClass="sub-modal">
            <HBox alignment="CENTER_LEFT">
                <Label text="LOAD GAME" styleClass="card-heading"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCloseLoadOverlay" styleClass="btn-secondary"/>
            </HBox>
            <Label fx:id="loadStatusLabel"
                   text="Select a save. Files are stored under your user folder (.sportmanager/saves)."
                   styleClass="label-small" wrapText="true"/>
            <ListView fx:id="saveListView" prefHeight="360" styleClass="player-list"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Delete Selected" onAction="#onDeleteSelectedSave" styleClass="btn-secondary"/>
                <Button text="Load Selected" onAction="#onLoadSelectedSave" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
