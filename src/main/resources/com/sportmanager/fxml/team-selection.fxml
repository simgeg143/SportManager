<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportmanager.ui.controller.TeamSelectionController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button text="← Back" onAction="#onBack" styleClass="nav-btn"/>
            <Label text="🏟" styleClass="nav-icon"/>
            <Label fx:id="leagueTitleLabel" text="Select Your Club" styleClass="nav-team-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="teamCountLabel" text="" styleClass="nav-subtitle"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="page-body">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                        VBox.vgrow="ALWAYS" styleClass="team-scroll">
                <GridPane fx:id="teamGrid" hgap="16" vgap="16">
                    <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                </GridPane>
            </ScrollPane>

        </VBox>
    </center>

    <bottom>
        <HBox styleClass="bottom-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
            <Label fx:id="confirmHintLabel"
                   text="Click a club to select it — click again to confirm"
                   styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
            <Button text="Confirm Selection" onAction="#onConfirm"
                    styleClass="btn-primary" prefWidth="180"/>
        </HBox>
    </bottom>

</BorderPane>
